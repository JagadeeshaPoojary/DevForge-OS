@'
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build output
dist
dist-ssr

# Environment files
.env
.env.*
!.env.example

# Local environment files
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea

# OS files
.DS_Store

# Database backups
*.backup
*.bak

# Archives
*.zip
'@ | Set-Content "frontend\.gitignore" -Encoding UTF8*.sql
